CONTROL_SERVER_PORT=8787
CONTROL_SERVER_HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,null
# Reverse proxies allowed to set X-Forwarded-For, as addresses/CIDRs. Rate limits key on the
# client address, so behind a proxy this MUST name it or all clients share one bucket.
# Leave empty when the control server is exposed directly. Never set it to a wildcard.
TRUST_PROXY=172.16.0.0/12
# Use internet for the public control node. Embedded Electron hosts override this to embedded.
DEPLOYMENT_MODE=internet
STUN_URLS=stun:stun.cloudflare.com:3478
SFU_ENABLED=true
SFU_VIEWER_THRESHOLD=2

# These values must match the LiveKit deployment.
# The control server refuses to start while they still hold the example values below, because those
# keys are published in this repository and livekit.yaml enables room auto_create.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-before-production
# Local-development escape hatch for the check above. Never set this on a public control node.
# ALLOW_INSECURE_DEFAULTS=true
# This URL is returned to Electron clients, so it must be publicly reachable.
LIVEKIT_WS_URL=wss://media.example.com
# Optional internal HTTP address used by the control service for health checks.
LIVEKIT_API_URL=http://livekit:7880

# coturn REST API shared secret and public client-facing URLs. Do not use localhost here.
# For UDP/TCP TURN, include a public IPv4 literal as a DNS-independent fallback.
# Keep the certificate hostname for turns: URLs because TLS certificate validation requires it.
TURN_SHARED_SECRET=dev-turn-secret-change-before-production
TURN_URLS=stun:203.0.113.10:3478,turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Public IP and Docker bridge address used by coturn's relay mapping.
TURN_EXTERNAL_IP=203.0.113.10/172.19.0.3
