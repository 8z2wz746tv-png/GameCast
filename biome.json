{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "apps/desktop/src/**/*.{ts,tsx}",
      "apps/desktop/electron/**/*.{ts,cts}",
      "apps/server/src/**/*.ts",
      "packages/contracts/src/**/*.d.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useHookAtTopLevel": "off"
      },
      "a11y": {
        "useMediaCaption": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
