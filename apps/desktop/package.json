{
  "name": "@gamecast/desktop",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "GameCast Windows desktop client",
  "author": "GameCast contributors",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && npm run build:electron",
    "clean:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "build:electron": "npm run clean:electron && tsc -p tsconfig.electron.json && esbuild electron/native-media.ts --bundle --platform=node --format=esm --target=node22 --external:electron --external:ffmpeg-static --sourcemap --banner:js=\"import { createRequire as __gamecastCreateRequire } from 'node:module'; const require = __gamecastCreateRequire(import.meta.url);\" --outfile=dist-electron/native-media.js",
    "package:win": "npm run build && electron-builder --win --x64",
    "test": "tsx --test src/p2p/quality-policy.test.ts src/p2p/display-capture-error.test.ts src/p2p/inbound-stall-detector.test.ts src/p2p/ice-candidate-buffer.test.ts src/p2p/connection-recovery-policy.test.ts src/p2p/signaling-client.test.ts src/room-invitation.test.ts src/server-address.test.ts electron/async-line-writer.test.ts electron/diagnostics.test.ts electron/ipc-validation.test.ts electron/native-output.test.ts electron/native-rtp-fanout.test.ts electron/native-rtp-webrtc.test.ts electron/rtp-continuity.test.ts electron/serial-task-queue.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@gamecast/contracts": "0.1.0",
    "@gamecast/server": "0.1.0",
    "ffmpeg-static": "^5.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "cross-env": "^10.0.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "livekit-client": "^2.15.6",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "vite": "^7.1.3",
    "werift": "^0.24.3",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "dev.gamecast.desktop",
    "productName": "GameCast",
    "asar": true,
    "directories": {
      "output": "release-friends"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist-electron/**/*.map",
      "!node_modules/@gamecast/server/src/**/*",
      "!node_modules/@gamecast/server/dist/**/*.map",
      "!node_modules/livekit-server-sdk/src/**/*",
      "!node_modules/zod/src/**/*",
      "!node_modules/json-schema-traverse/spec/**/*",
      "!node_modules/**/*.test.*",
      "!node_modules/**/*.spec.*",
      "!node_modules/**/*.map",
      "!node_modules/ffmpeg-static/ffmpeg.exe",
      "!node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
      "!node_modules/ffmpeg-static/ffmpeg.exe.README"
    ],
    "extraResources": [
      {
        "from": "../../node_modules/ffmpeg-static",
        "to": "native",
        "filter": [
          "ffmpeg.exe",
          "ffmpeg.exe.LICENSE",
          "ffmpeg.exe.README"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GameCast-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GameCast",
      "artifactName": "GameCast-${version}-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "GameCast-${version}-portable-${arch}.${ext}"
    }
  }
}
