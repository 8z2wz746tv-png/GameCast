{
  "name": "@gamecast/server",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./embedded": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test src/config.test.ts src/services/room-service.test.ts src/services/request-rate-limiter.test.ts src/services/media-routing-policy.test.ts src/signal.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@gamecast/contracts": "0.1.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "livekit-server-sdk": "^2.13.2",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5"
  }
}
